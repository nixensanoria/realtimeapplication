{
  "name": "lol-quiz-game",
  "version": "1.0.0",
  "description": "League of Legends Multiplayer Quiz Game with Socket.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate.js",
    "deploy": "npm run migrate && npm start",
    "docker:build": "docker build -t lol-quiz-game .",
    "docker:run": "docker run -p 3000:3000 --env-file .env lol-quiz-game",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "League of Legends",
    "Quiz",
    "Multiplayer",
    "Socket.io",
    "Real-time"
  ],
  "author": "Juan Dela Cruz",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "socket.io": "^4.8.4"
  }
}
